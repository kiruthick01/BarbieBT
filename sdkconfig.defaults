CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Classic BT only (HFP needs BR/EDR). Drop BLE to save RAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_SSP_ENABLED=y

# HFP client, audio over HCI (app gets PCM frames -> bridge to I2S in stage 6)
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y

CONFIG_FREERTOS_HZ=1000

CONFIG_BARBIE_TONE_VOLUME_PCT=25
CONFIG_BARBIE_STAGE_5_CALL=y
# narrowband CVSD only: bridge is 8 kHz PCM
CONFIG_BT_HFP_WBS_ENABLE=n
# allow one SCO/eSCO voice link (default 0 rejects all call audio)
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BARBIE_CALL_VOLUME_PCT=60
